# Comma-separated 10-digit PNRs. Never put real PNRs in this template.
PNR_NUMBER=

# Optional RapidAPI fallback. Leave empty to use direct unlimited open rail gateway.
RAPIDAPI_KEY=
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Configure at least one notification channel for real alerts:
# 1. ntfy.sh (Recommended: Instant mobile push notifications, zero setup)
NTFY_TOPIC=

# 2. WhatsApp via CallMeBot (Optional)
WHATSAPP_PHONE=
CALLMEBOT_API_KEY=

# 3. Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local-only testing. Set true to avoid external notification requests.
DRY_RUN=false
