# IRCTC PNR Waiting List Notifier Configuration

# Your 10-digit Indian Railways PNR number
PNR_NUMBER=1234567890

# RapidAPI credentials (Free tier from RapidAPI)
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=irctc-indian-railway-pnr-status.p.rapidapi.com

# WhatsApp Notification via CallMeBot (100% Free)
# 1. Add phone number in international format (+91...)
# 2. To get your CallMeBot API key, send:
#    "I allow callmebot to send me messages" to +34 911 06 14 99 on WhatsApp
WHATSAPP_PHONE=+919876543210
CALLMEBOT_API_KEY=your_callmebot_api_key_here

# Optional: Set to true to test without calling real WhatsApp API
DRY_RUN=false
